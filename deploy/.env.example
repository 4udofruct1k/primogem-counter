# Скопируйте в .env (cp .env.example .env) и заполните. Файл .env в git не попадает.

# Домен сайта: A-запись primo.<домен> → IP сервера; Caddy сам получит сертификат Let's Encrypt.
DOMAIN=primo.example.ru

# Пароль БД — длинный случайный, лучше только буквы и цифры (он входит в URL подключения):
#   openssl rand -hex 24
POSTGRES_PASSWORD=<длинный случайный>
DATABASE_URL=postgres://primo:${POSTGRES_PASSWORD}@db:5432/primo

SESSION_TTL_DAYS=30
NODE_ENV=production

# Администраторов данных (админка шаблона ивентов и патча датапака) назначает оператор командой после регистрации на
# сайте (D-316): docker compose -f compose.prod.yml exec api node dist/cli.js admin grant <логин>
# Прежняя ADMIN_USERNAMES больше не читается — при старте api пишет предупреждение.

# Квоты аккаунта (D-312): документов и МБ данных. По умолчанию 200000 и 32 — хватает на годы игры.
# USER_MAX_DOCS=200000
# USER_MAX_MB=32
