# Сайт «Копилка круток» (15.3). Манифест игровых данных, патч админки и файлы по ссылкам манифеста (`?v=`) отдаёт
# api (хэши и версия патча из БД), остальные data/*.json — статикой.
{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	handle /api/* {
		reverse_proxy api:3000
	}
	@dynamicData path /data/manifest.json /data/patch-*
	handle @dynamicData {
		reverse_proxy api:3000
	}
	# Ссылки из манифеста /data/<файл>?v=<хэш> (D-317) отдаёт api: манифест он строит по своей копии data/, сверяет
	# хэш с отдаваемым файлом и только тогда ставит immutable. Здесь, в /srv/data (checkout на хосте), после
	# `git pull` уже новые файлы, а api со старым манифестом ещё не пересобран.
	@versionedData {
		path /data/*
		query v=*
	}
	handle @versionedData {
		reverse_proxy api:3000
	}
	handle /data/* {
		root * /srv
		header Cache-Control "public, max-age=300"
		file_server
	}
	handle {
		root * /srv/web
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@entry path / /index.html /sw.js /registerSW.js /manifest.webmanifest
		header @entry Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
