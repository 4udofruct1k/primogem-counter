# Переменные окружения api (apps/api/src/config.ts). Пример без секретов: скопируйте в .env и заполните.
# tsx/node сами .env не читают — передайте переменные через окружение или docker compose (env_file).

# development | production. В production обязательны DATABASE_URL и PUBLIC_ORIGIN или DOMAIN.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# PostgreSQL 16. По умолчанию вне production — postgres://primo:primo@localhost:5432/primo (deploy/compose.dev.yml).
# Без Docker: DATABASE_URL=pglite:memory (в памяти) или pglite:./.pglite (папка) — Postgres в WASM, только для разработки.
DATABASE_URL=postgres://primo:<пароль>@localhost:5432/primo

# Домен сайта: Origin https://$DOMAIN разрешён для изменяющих запросов (CSRF) и CORS.
DOMAIN=primo.example.ru
# Или явно (через запятую). Вне production дополнительно разрешён http://localhost:5173 (Vite).
# PUBLIC_ORIGIN=https://primo.example.ru

# Сессии: срок в днях, продлевается при активности.
SESSION_TTL_DAYS=30
# Флаг Secure у cookie. По умолчанию true в production и false в разработке (http://localhost).
# COOKIE_SECURE=true

# Админы данных (админка патча датапака) — флаг аккаунта, который ставит оператор (D-316), а не переменная:
#   pnpm --filter @primo/api exec tsx src/cli.ts admin grant <логин>   (в образе: node dist/cli.js admin grant <логин>)
# Прежняя ADMIN_USERNAMES больше не читается — при старте api пишет предупреждение.

# Адреса доверенных прокси (Caddy) для X-Forwarded-For: loopback,uniquelocal по умолчанию; true / false.
# TRUST_PROXY=loopback,uniquelocal

# Папки игровых данных и миграций; по умолчанию — data/ репозитория и apps/api/drizzle/.
# DATA_DIR=/srv/data
# MIGRATIONS_DIR=/app/drizzle

# Версия в /api/health и уровень логов (fatal, error, warn, info, debug, trace, silent).
APP_VERSION=0.0.0
LOG_LEVEL=info
